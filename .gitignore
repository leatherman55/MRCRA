# Training products are local by default.  Retain only the small, reproducible
# specifications, reports, and acceptance evidence stored at outputs/ root.
outputs/*
!outputs/*.json
!outputs/*.md
*.ckpt
*.pt
*.pth
*.safetensors
*.whl

# Rebuildable Trackio frontend dependencies and bundles.
trackio_frontend/node_modules/
trackio_frontend/.svelte-kit/
trackio_frontend/.vite/
trackio_frontend/dist/

# Runtime logs and scratch databases.
*.log
*.sqlite
*.sqlite3
